#!/usr/bin/env node
'use strict';
// porch CLI: manages work folders in the Porch store. On PATH inside Claude Code while the plugin is enabled.
//
// Store: $PORCH_HOME (default ~/.porch)
//   voice.md                      optional, written by /porch:voice; extends the plugin's base voice
//   articles/<uuid>/              one work folder per piece
//   case-studies/<uuid>/
//     state.json                  id, type, status, title, topic, slug, tags, timestamps, ...
//     intake/<file or folder>     copy of what /porch:brief was given
//     brief.md, draft.md, review.md

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');

const TYPES = { article: 'articles', 'case-study': 'case-studies' };
const STATUSES = ['new', 'briefed', 'drafting', 'approved', 'escalated', 'pushed'];
const KINDS = ['notes', 'draft'];
const FILES = { brief: 'brief.md', draft: 'draft.md', review: 'review.md', state: 'state.json' };
const SETTABLE = ['title', 'topic', 'slug', 'tags', 'status', 'kind', 'draft_source', 'note', 'porch_id'];
const SKIP = new Set(['.git', 'node_modules', '.DS_Store', '.porch']);
const MAX_BYTES = 25 * 1024 * 1024;
const MAX_FILES = 2000;
const has = (obj, k) => typeof k === 'string' && Object.prototype.hasOwnProperty.call(obj, k);
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;

const out = (s = '') => process.stdout.write(s + '\n');
const fail = (msg) => { process.stderr.write(`porch: ${msg}\n`); process.exit(1); };

function expandHome(p) {
  return p === '~' || p.startsWith('~/') ? path.join(os.homedir(), p.slice(1)) : p;
}
function home() {
  const raw = process.env.PORCH_HOME || '~/.porch';
  const p = expandHome(raw);
  if (!path.isAbsolute(p)) fail(`PORCH_HOME must be an absolute path or start with ~/, got "${raw}"`);
  return path.resolve(p);
}
/** The store path with symlinks resolved, for comparing against real intake paths. */
function realHome() {
  try { return fs.realpathSync(home()); } catch { return home(); }
}
const inside = (child, parent) => child === parent || child.startsWith(parent + path.sep);
const now = () => new Date().toISOString();

function parseArgs(argv, bools) {
  const pos = [];
  const opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--') { pos.push(...argv.slice(i + 1)); break; }
    if (a.startsWith('--')) {
      const [k, inline] = a.slice(2).split(/=(.*)/s);
      if (bools.has(k)) {
        if (inline !== undefined) fail(`--${k} takes no value`);
        opt[k] = true;
      } else if (inline !== undefined) opt[k] = inline;
      else if (i + 1 >= argv.length || argv[i + 1].startsWith('--')) fail(`--${k} needs a value`);
      else opt[k] = argv[++i];
    } else pos.push(a);
  }
  return { pos, opt };
}

// ---------- store ----------

function readState(dir) {
  try {
    return JSON.parse(fs.readFileSync(path.join(dir, FILES.state), 'utf8'));
  } catch {
    return null;
  }
}

function writeState(dir, state) {
  const file = path.join(dir, FILES.state);
  const tmp = `${file}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(state, null, 2) + '\n');
  fs.renameSync(tmp, file);
}

/** Why a state can't be used, or null. The id must match the folder name and the type its parent. */
function invalid(state, name, type) {
  if (!state || typeof state !== 'object' || Array.isArray(state)) return 'state.json is missing or not a JSON object';
  if (state.id !== name) return `id ${JSON.stringify(state.id)} does not match the folder name`;
  if (state.type !== type) return `type ${JSON.stringify(state.type)} does not match the folder`;
  return null;
}

let warned = false;

/** Every valid work folder in the store: [{ dir, state }]. Broken ones are skipped with a warning on stderr. */
function all() {
  const items = [];
  const broken = [];
  for (const [type, sub] of Object.entries(TYPES)) {
    const base = path.join(home(), sub);
    let names = [];
    try { names = fs.readdirSync(base); } catch { continue; }
    for (const name of names) {
      if (!UUID.test(name)) continue;
      const dir = path.join(base, name);
      const state = readState(dir);
      const why = invalid(state, name, type);
      if (why) { broken.push(`${dir}: ${why}`); continue; }
      if (!Array.isArray(state.tags)) state.tags = [];
      items.push({ dir, state });
    }
  }
  if (broken.length && !warned) {
    warned = true;
    for (const b of broken) process.stderr.write(`porch: skipping ${b}\n`);
  }
  return items;
}

/** Resolve a full id or a unique prefix of at least 4 characters. */
function resolve(ref) {
  if (!ref) fail('missing work id (see `porch list`)');
  const r = String(ref).toLowerCase();
  if (r.length < 4) fail(`id "${ref}" is too short; give at least 4 characters`);
  const hits = all().filter((w) => w.state.id.startsWith(r));
  if (hits.length === 0) fail(`no work folder matches "${ref}" in ${home()}`);
  if (hits.length > 1) fail(`"${ref}" matches ${hits.length} work folders: ${hits.map((w) => w.state.id).join(', ')}`);
  return hits[0];
}

function filesIn(dir) {
  return Object.values(FILES).filter((f) => f !== FILES.state && fs.existsSync(path.join(dir, f)));
}

/**
 * List what the copy takes: real files and folders only, leaving out SKIP names, symlinks (the intake
 * is a snapshot) and the store itself. Unreadable entries are skipped and listed in `unreadable`.
 * Unless `force`, the walk stops as soon as a limit is passed and sets `over`.
 */
function measure(root, force) {
  const r = { files: 0, bytes: 0, links: 0, list: [], dirs: [], unreadable: [], over: false };
  const store = realHome();
  const STOP = Symbol('stop');
  const walk = (p) => {
    let st;
    try { st = fs.lstatSync(p); } catch (e) { r.unreadable.push(`${p} (${e.code || e.message})`); return; }
    if (st.isSymbolicLink()) { r.links++; return; }
    if (st.isDirectory()) {
      let names;
      try { names = fs.readdirSync(p); } catch (e) { r.unreadable.push(`${p} (${e.code || e.message})`); return; }
      r.dirs.push(p);
      for (const n of names) {
        const c = path.join(p, n);
        if (!SKIP.has(n) && !inside(c, store)) walk(c);
      }
    } else if (st.isFile()) {
      try { fs.accessSync(p, fs.constants.R_OK); } catch (e) { r.unreadable.push(`${p} (${e.code || e.message})`); return; }
      r.files++;
      r.bytes += st.size;
      r.list.push(p);
      if (!force && (r.files > MAX_FILES || r.bytes > MAX_BYTES)) { r.over = true; throw STOP; }
    }
  };
  try { walk(root); } catch (e) { if (e !== STOP) throw e; }
  return r;
}

/**
 * Build a work folder in <home>/.staging/<id>, then rename it into <home>/<type dir>/<id>.
 * A failure anywhere removes the staging folder, so a failed create leaves nothing in the store.
 */
function createWork(type, build) {
  const id = crypto.randomUUID();
  const staging = path.join(home(), '.staging', id);
  const dir = path.join(home(), TYPES[type], id);
  try {
    // Private by default, but only when this creates the store: never change an existing folder's mode.
    if (!fs.existsSync(home())) fs.mkdirSync(home(), { recursive: true, mode: 0o700 });
    fs.mkdirSync(staging, { recursive: true, mode: 0o700 });
    const state = build(staging, id);
    writeState(staging, state);
    fs.mkdirSync(path.dirname(dir), { recursive: true, mode: 0o700 });
    fs.renameSync(staging, dir);
    return { ...state, dir };
  } catch (e) {
    fs.rmSync(staging, { recursive: true, force: true });
    fail(`could not create the work folder: ${e.message}`);
  }
}

/** Minimal frontmatter reader: top-level `key: value` lines only. */
function frontmatter(file) {
  let text;
  try { text = fs.readFileSync(file, 'utf8'); } catch { return null; }
  const m = /^---\r?\n([\s\S]*?)\r?\n---/.exec(text);
  if (!m) return {};
  const fm = {};
  for (const line of m[1].split(/\r?\n/)) {
    const kv = /^([A-Za-z_]+):[ \t]*(.*)$/.exec(line);
    if (kv) fm[kv[1]] = scalar(kv[2]);
  }
  return fm;
}

/** A YAML scalar: a quoted string (with '' or \" escapes), or plain text up to a " #" comment. */
function scalar(raw) {
  const v = raw.trim();
  if (v.startsWith('"')) {
    const m = /^"((?:[^"\\]|\\.)*)"/.exec(v);
    if (m) return m[1].replace(/\\(["\\])/g, '$1');
  } else if (v.startsWith("'")) {
    const m = /^'((?:[^']|'')*)'/.exec(v);
    if (m) return m[1].replace(/''/g, "'");
  }
  return v.replace(/(^|\s)#.*$/, '').trim();
}

// ---------- commands ----------

function cmdInit(argv) {
  const { pos, opt } = parseArgs(argv, new Set(['json', 'force']));
  const src = pos[0];
  if (!src) fail('usage: porch init <path> --type article|case-study --topic text [--note text] [--force] [--json]');
  if (!has(TYPES, opt.type)) fail(`--type must be article or case-study, got "${opt.type ?? ''}"`);
  if (!opt.topic || !String(opt.topic).trim()) {
    fail('--topic is required: run the intake check (references/intake.md) first and pass the topic it found');
  }
  const given = path.resolve(expandHome(src));
  let abs;
  try { abs = fs.realpathSync(given); } catch { fail(`no such file or folder: ${given}`); }
  const st = fs.statSync(abs);
  if (!st.isFile() && !st.isDirectory()) fail(`not a file or folder: ${abs}`);
  if (inside(abs, realHome())) fail(`the intake is inside the store (${home()})`);

  const size = measure(abs, opt.force);
  if (size.over) {
    fail(`${abs} has more than ${MAX_FILES} files or ${MAX_BYTES / 1048576} MB; ` +
      'point at a smaller folder or pass --force.');
  }
  if (size.files === 0) fail(`nothing readable to copy in ${abs}`);

  const name = path.basename(given);
  const work = createWork(opt.type, (staging, id) => {
    fs.mkdirSync(path.join(staging, 'intake'));
    // Copy file by file from the measured list. fs.cpSync refuses any destination inside the source,
    // even one its filter would skip, and the store may sit inside the intake.
    const dest = path.join(staging, 'intake', name);
    const to = (p) => (p === abs ? dest : path.join(dest, path.relative(abs, p)));
    for (const d of size.dirs) fs.mkdirSync(to(d), { recursive: true });
    for (const file of size.list) {
      fs.mkdirSync(path.dirname(to(file)), { recursive: true });
      fs.copyFileSync(file, to(file));
    }
    const t = now();
    return {
      id,
      type: opt.type,
    status: 'new',
    title: (st.isDirectory() ? name : name.replace(/(.)\.[^.]+$/, '$1')) || name,
    topic: String(opt.topic).trim(),
    slug: '',
    tags: [],
    kind: null,
    note: opt.note || '',
    source: given,
    intake: `intake/${name}`,
    porch_id: null,
    created_at: t,
    updated_at: t,
    };
  });
  if (size.links) process.stderr.write(`porch: skipped ${size.links} symlink(s); the intake is a snapshot of real files only\n`);
  if (size.unreadable.length) {
    process.stderr.write(`porch: skipped ${size.unreadable.length} unreadable path(s):\n`);
    for (const u of size.unreadable.slice(0, 10)) process.stderr.write(`  ${u}\n`);
    if (size.unreadable.length > 10) process.stderr.write(`  … and ${size.unreadable.length - 10} more\n`);
  }
  if (opt.json) out(JSON.stringify({ ...work, skipped_links: size.links, skipped_unreadable: size.unreadable }, null, 2));
  else out(`${work.id}\n${work.dir}`);
}

/** Import 0.1.0 work folders (<project>/.porch/<slug>/ with brief.md, draft.md, review.md). */
function cmdImport(argv) {
  const { pos, opt } = parseArgs(argv, new Set(['json']));
  if (!pos.length) fail('usage: porch import <project>/.porch/<slug>… [--json]');
  // Check every folder before creating anything, so a bad one later in the list leaves nothing half done.
  const plan = [];
  for (const src of pos) {
    let abs;
    try { abs = fs.realpathSync(path.resolve(expandHome(src))); } catch { fail(`no such folder: ${src}`); }
    if (!fs.statSync(abs).isDirectory()) fail(`not a folder: ${abs}`);
    const brief = frontmatter(path.join(abs, 'brief.md'));
    const draft = frontmatter(path.join(abs, 'draft.md'));
    if (!brief && !draft) fail(`${abs} has no brief.md or draft.md; is it a .porch/<slug> folder?`);
    const type = (brief && brief.type) || (draft && draft.type);
    if (!has(TYPES, type)) fail(`${abs}: type must be article or case-study, got "${type || ''}"`);
    plan.push({ abs, brief, draft, type });
  }
  const done = [];
  const voices = new Set();
  for (const { abs, brief, draft, type } of plan) {
    const dup = all().find((w) => w.state.source === abs);
    if (dup) {
      const msg = `skipped ${abs}: already imported as ${dup.state.id.slice(0, 8)}`;
      if (opt.json) process.stderr.write(`porch: ${msg}\n`);
      else out(msg);
      continue;
    }

    const slug = (brief && brief.slug) || (draft && draft.slug) || path.basename(abs);
    let review = '';
    try { review = fs.readFileSync(path.join(abs, 'review.md'), 'utf8'); } catch { /* none */ }
    const approved = /(^|\n)\s*approved\s*$/.test(review);
    // Approved: the files stay at the root so /porch:push works. Otherwise they become the intake
    // of a new work folder, which /porch:brief <id> checks and briefs again.
    const work = createWork(type, (staging, id) => {
      const target = approved ? staging : path.join(staging, 'intake', path.basename(abs));
      fs.mkdirSync(target, { recursive: true });
      for (const f of ['brief.md', 'draft.md', 'review.md']) {
        if (fs.existsSync(path.join(abs, f))) fs.copyFileSync(path.join(abs, f), path.join(target, f));
      }
      const t = now();
      return {
        id,
        type,
        status: approved ? 'approved' : 'new',
        title: (draft && draft.title) || slug,
        topic: (brief && brief.thesis) || (draft && draft.title) || slug,
        slug: /^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug) ? slug : '',
        tags: [],
        kind: null,
        note: 'imported from porch 0.1.0',
        source: abs,
        intake: approved ? null : `intake/${path.basename(abs)}`,
        porch_id: null,
        created_at: t,
        updated_at: t,
      };
    });
    done.push(work);
    const voice = path.join(path.dirname(abs), 'voice.md');
    if (path.basename(path.dirname(abs)) === '.porch' && fs.existsSync(voice)) voices.add(voice);
    if (!opt.json) {
      out(`imported ${work.id.slice(0, 8)}  ${work.type}  ${work.status}  ${work.title}`);
      out(approved ? `  push it with /porch:push ${work.id.slice(0, 8)}` : `  brief it again with /porch:brief ${work.id.slice(0, 8)}`);
    }
  }
  if (opt.json) out(JSON.stringify(done, null, 2));
  const target = path.join(home(), 'voice.md');
  for (const v of voices) {
    process.stderr.write(fs.existsSync(target)
      ? `porch: ${v} is not used any more; the store's ${target} applies\n`
      : `porch: ${v} is not used any more; copy it to ${target} (it now extends the base voice) or run /porch:voice\n`);
  }
}

const pad = (s, n) => {
  s = String(s ?? '');
  return s.length > n ? s.slice(0, n - 1) + '…' : s.padEnd(n);
};

function cmdList(argv) {
  const { opt } = parseArgs(argv, new Set(['json']));
  if (opt.type && !has(TYPES, opt.type)) fail('--type must be article or case-study');
  const statuses = opt.status ? String(opt.status).split(',').map((x) => x.trim()) : null;
  if (statuses && !statuses.every((x) => STATUSES.includes(x))) fail(`--status must be one or more of ${STATUSES.join(', ')}`);
  let items = all();
  if (opt.type) items = items.filter((w) => w.state.type === opt.type);
  if (statuses) items = items.filter((w) => statuses.includes(w.state.status));
  if (opt.tag) items = items.filter((w) => (w.state.tags || []).includes(opt.tag));
  items.sort((a, b) => String(b.state.updated_at).localeCompare(String(a.state.updated_at)));

  if (opt.json) return out(JSON.stringify(items.map((w) => ({ ...w.state, dir: w.dir })), null, 2));
  out(`store: ${home()}`);
  if (!items.length) return out('no work folders yet; start one with /porch:brief <path> <type>');
  out(`${pad('ID', 9)} ${pad('TYPE', 11)} ${pad('STATUS', 10)} ${pad('UPDATED', 11)} ${pad('TAGS', 20)} TITLE`);
  for (const { state: s } of items) {
    out(`${pad(s.id.slice(0, 8), 9)} ${pad(s.type, 11)} ${pad(s.status, 10)} ${pad(String(s.updated_at).slice(0, 10), 11)} ` +
      `${pad((s.tags || []).join(','), 20)} ${s.title || ''}`);
  }
}

function cmdRead(argv) {
  const { pos, opt } = parseArgs(argv, new Set(['json', 'path']));
  const w = resolve(pos[0]);
  const which = pos[1];
  if (which && !has(FILES, which)) fail(`file must be one of ${Object.keys(FILES).join(', ')}`);
  if (opt.path) return out(which ? path.join(w.dir, FILES[which]) : w.dir);
  if (which) {
    if (!has(FILES, which)) fail(`file must be one of ${Object.keys(FILES).join(', ')}`);
    const f = path.join(w.dir, FILES[which]);
    if (!fs.existsSync(f)) fail(`${w.state.id} has no ${FILES[which]} yet`);
    return process.stdout.write(fs.readFileSync(f, 'utf8'));
  }
  const files = filesIn(w.dir);
  if (opt.json) return out(JSON.stringify({ ...w.state, dir: w.dir, files }, null, 2));
  const s = w.state;
  out(`id:       ${s.id}`);
  out(`type:     ${s.type}`);
  out(`status:   ${s.status}`);
  out(`title:    ${s.title}`);
  if (s.topic) out(`topic:    ${s.topic}`);
  if (s.slug) out(`slug:     ${s.slug}`);
  out(`tags:     ${(s.tags || []).join(', ') || '-'}`);
  if (s.kind) out(`kind:     ${s.kind}`);
  if (s.draft_source) out(`draft:    ${s.draft_source}`);
  if (s.note) out(`note:     ${s.note}`);
  if (s.porch_id) out(`porch_id: ${s.porch_id}`);
  out(`source:   ${s.source}`);
  out(`created:  ${s.created_at}`);
  out(`updated:  ${s.updated_at}`);
  out(`dir:      ${w.dir}`);
  out(`files:    ${[s.intake, ...files].filter(Boolean).join(', ')}`);
}

function cmdSet(argv) {
  const [ref, ...pairs] = argv;
  const w = resolve(ref);
  if (!pairs.length) fail(`usage: porch set <id> key=value…  (keys: ${SETTABLE.join(', ')})`);
  const s = { ...w.state };
  for (const p of pairs) {
    const m = /^([a-z_]+)=(.*)$/s.exec(p);
    if (!m) fail(`expected key=value, got "${p}"`);
    const [, k, v] = m;
    if (!SETTABLE.includes(k)) fail(`cannot set "${k}"; settable keys: ${SETTABLE.join(', ')}`);
    if (k === 'status' && !STATUSES.includes(v)) fail(`status must be one of ${STATUSES.join(', ')}`);
    if (k === 'kind' && !KINDS.includes(v)) fail(`kind must be one of ${KINDS.join(', ')}`);
    if (k === 'slug' && v && !/^[a-z0-9]+(-[a-z0-9]+)*$/.test(v)) fail(`slug must be lowercase words joined by "-", got "${v}"`);
    if (k === 'topic' && !v.trim()) fail('topic cannot be empty');
    if (k === 'draft_source') {
      const rel = path.normalize(v);
      const file = path.join(w.dir, rel);
      if (!rel.startsWith('intake' + path.sep) || !inside(file, path.join(w.dir, 'intake'))) {
        fail(`draft_source must be a path inside intake/, got "${v}"`);
      }
      let ok = false;
      try { ok = fs.lstatSync(file).isFile(); } catch { /* missing */ }
      if (!ok) fail(`draft_source ${v} is not a file in ${w.state.id.slice(0, 8)}`);
    }
    if (k === 'tags') s.tags = v.split(',').map((t) => t.trim()).filter(Boolean);
    else if (k === 'porch_id') s.porch_id = v || null;
    else s[k] = v;
  }
  s.updated_at = now();
  writeState(w.dir, s);
  out(`updated ${s.id}: ${pairs.map((p) => p.split('=')[0]).join(', ')}`);
}

function cmdDelete(argv) {
  const { pos, opt } = parseArgs(argv, new Set(['yes']));
  if (!pos.length) fail('usage: porch delete <id>… [--yes]');
  const targets = pos.map(resolve);
  for (const w of targets) {
    // Belt and braces: only ever remove <home>/<type dir>/<uuid>.
    const rel = path.relative(home(), w.dir).split(path.sep);
    if (rel.length !== 2 || !Object.values(TYPES).includes(rel[0]) || !UUID.test(rel[1])) {
      fail(`refusing to delete ${w.dir}: not a work folder`);
    }
  }
  if (!opt.yes) {
    out('would delete (run again with --yes):');
    for (const w of targets) out(`  ${w.state.id.slice(0, 8)}  ${w.state.type}  ${w.state.title}`);
    return;
  }
  for (const w of targets) {
    fs.rmSync(w.dir, { recursive: true, force: true });
    out(`deleted ${w.state.id}  ${w.state.title}`);
  }
}

const help = () => `porch: manage Porch work folders in ${home()}  (set PORCH_HOME to move it)

  porch init <path> --type article|case-study --topic text [--note text] [--force] [--json]
      copy a file or folder that passed the intake check into a new work folder
  porch import <project>/.porch/<slug>… [--json]
      bring 0.1.0 work folders into the store (approved drafts stay pushable)
  porch list [--type t] [--status s[,s…]] [--tag x] [--json]
  porch read <id> [brief|draft|review|state] [--path] [--json]
  porch set <id> key=value…      keys: ${SETTABLE.join(', ')}
      status: ${STATUSES.join(' | ')}   tags: comma-separated
  porch delete <id>… [--yes]     without --yes it only shows what it would delete
  porch home                     print the store path

An <id> may be any unique prefix of at least 4 characters.`;

const COMMANDS = {
  init: cmdInit,
  import: cmdImport,
  list: cmdList,
  ls: cmdList,
  read: cmdRead,
  show: cmdRead,
  set: cmdSet,
  delete: cmdDelete,
  rm: cmdDelete,
  home: () => out(home()),
};

if (require.main === module) {
  const [cmd, ...rest] = process.argv.slice(2);
  if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') out(help());
  else if (has(COMMANDS, cmd)) COMMANDS[cmd](rest);
  else fail(`unknown command "${cmd}". Run \`porch help\`.`);
}

module.exports = { home, resolve, all };
