#!/usr/bin/env node
'use strict';
// casebook CLI. On PATH inside Claude Code while the plugin is enabled (plugin bin/).

const fs = require('fs');
const path = require('path');
const { spawn, spawnSync } = require('child_process');
const U = require('../lib/util');
const store = require('../lib/store');
const { resolveProject } = require('../lib/project');
const { scoutSession, sweep } = require('../lib/scout');
const F = require('../lib/filter');
const D = require('../lib/discover');
const T = require('../lib/topics');

const BOOL = new Set(['all', 'marked', 'unmarked', 'written', 'unwritten', 'json', 'path', 'yes', 'force', 'dry-run', 'help', 'handoff',
  'auto', 'live', 'pending', 'background', 'quiet']);

function parseArgs(argv) {
  const pos = [];
  const opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--') { pos.push(...argv.slice(i + 1)); break; }
    if (a.startsWith('--')) {
      const [k, inline] = a.slice(2).split(/=(.*)/s);
      const key = k.replace(/-([a-z])/g, (_, c) => c.toUpperCase());
      if (inline !== undefined) opt[key] = inline;
      else if (BOOL.has(k)) opt[key] = true;
      else opt[key] = argv[++i];
    } else pos.push(a);
  }
  return { pos, opt };
}

const out = (s = '') => process.stdout.write(s + '\n');
const fail = (msg) => { process.stderr.write(`casebook: ${msg}\n`); process.exit(1); };
// A log merged into another one by a scan lives on under the surviving ID.
function findLog(id) {
  const l = id && U.ID_RE.test(id) ? T.resolveLog(id) : null;
  if (l && l.meta.id !== id) process.stderr.write(`casebook: ${id} was merged into ${l.meta.id}\n`);
  return l;
}

function readStdinJson() {
  try {
    const raw = fs.readFileSync(0, 'utf8');
    return raw.trim() ? JSON.parse(raw) : {};
  } catch {
    return {};
  }
}

function detach(args) {
  // Pin the child to this profile, including when we were started from a terminal with --profile.
  const env = { ...process.env, CASEBOOK_PROFILE: U.paths.profileName() };
  if (U.paths.claudeConfigDirExplicit()) env.CLAUDE_CONFIG_DIR = U.paths.claudeConfigDir();
  const child = spawn(process.execPath, [__filename, ...args], { detached: true, stdio: 'ignore', env });
  child.unref();
}

function currentProject(opt, config) {
  if (opt.all) return null;
  return opt.project || resolveProject(process.cwd(), config).project;
}

function pad(s, n) {
  s = String(s ?? '');
  return s.length > n ? s.slice(0, n - 1) + '…' : s.padEnd(n);
}

function row(log) {
  const m = log.meta;
  const date = String(m.started_at || m.created_at || '').slice(0, 10);
  const score = `${m.score ?? '-'}${m.partial ? '…' : ''}`;
  return `${pad(m.id, 10)} ${pad(date, 11)} ${pad(score, 5)} ${pad(m.marked ? '📌' : '', 3)} ${pad(F.isWritten(log) ? '✓' : '', 3)} ${m.title || ''}${m.angle ? `  · ${m.angle}` : ''}`;
}

const HEADER = `${pad('ID', 10)} ${pad('DATE', 11)} ${pad('SCORE', 5)} ${pad('MRK', 3)} ${pad('WRT', 3)} TITLE`;

function parseLimit(v, fallback, flag = '--limit') {
  if (v === undefined) return fallback;
  const n = Number(v);
  if (!Number.isInteger(n) || n < 1) fail(`${flag} must be a positive whole number, got "${v}"`);
  return n;
}

function describe(r) {
  const one = (l) => `${l.status === 'created' ? 'Created' : 'Updated'} ${l.logId} (score ${l.score}${(l.partial ?? r.partial) ? ', partial' : ''}${r.logs && r.logs.length > 1 && l.angle ? `, ${l.angle}` : ''}): ${l.title}${l.merged && l.merged.length ? ` (merged ${l.merged.join(', ')})` : ''}`;
  if (r.status === 'created' || r.status === 'updated') return (r.logs && r.logs.length ? r.logs : [{ ...r }]).map(one).join('\n');
  if (r.status === 'running') return r.reason;
  if (r.status === 'error') return `Failed: ${r.reason}`;
  return `Skipped: ${r.reason}`;
}

/** `scout --pending`: the catch-up pass, run on demand. Auto-mode gates still apply to each session. */
function scoutPending(config, opt) {
  const meta = U.readJson(U.paths.meta(), {});
  const o = {
    since: meta.installedAt ? new Date(meta.installedAt) : null,
    exclude: opt.exclude,
    limit: parseLimit(opt.limit, config.sweep.maxPerRun),
    settleMinutes: 0,
    partialIfRecent: true,
  };
  const id8 = (r) => r.sessionId.slice(0, 8);
  if (opt.dryRun) {
    const { results } = sweep(config, { ...o, dryRun: true });
    if (opt.json) return out(JSON.stringify(results.map(({ sessionId, project, mtimeMs, userTurns }) => ({ sessionId, project, modified: new Date(mtimeMs).toISOString(), userTurns })), null, 2));
    if (!results.length) return out('No sessions to catch up on.');
    for (const r of results) out(`${id8(r)}  ${pad(r.project || '?', 24)} ${new Date(r.mtimeMs).toISOString().slice(0, 16).replace('T', ' ')}  ${r.userTurns ?? '?'} turns`);
    return;
  }
  const { results, locked } = sweep(config, o);
  if (locked) return out('A catch-up is already running. Check /casebook:list in a minute.');
  if (opt.json) return out(JSON.stringify(results.map(({ sessionId, status, logId, reason, score, title, partial, logs }) => ({ sessionId, status, logId, reason, score, title, partial, logs }))));
  if (!results.length) return out('No sessions to catch up on.');
  for (const r of results) out(`${id8(r)}  ${describe(r)}`);
}

// ------------------------------------------------------------------ commands

const commands = {
  // Hooks. Must stay fast and must never print to stdout (SessionStart stdout becomes context).
  hook({ pos }) {
    if (process.env.CASEBOOK_SCOUT) return;
    const input = readStdinJson();
    const sid = input.session_id;
    try {
      U.loadConfig();
      if (pos[0] === 'session-end' && sid) {
        detach(['scout', '--session', sid, ...(input.transcript_path ? ['--transcript', input.transcript_path] : []), ...(input.cwd ? ['--cwd', input.cwd] : []), '--auto', '--quiet']);
      } else if (pos[0] === 'session-start') {
        detach(['maintenance', ...(sid ? ['--exclude', sid] : [])]);
      }
    } catch (err) {
      U.logError(`hook ${pos[0]} failed`, err);
    }
  },

  scout({ pos, opt }) {
    const config = U.loadConfig();
    if (opt.pending) return scoutPending(config, opt);
    const sessionId = opt.session || pos[0];
    if (!sessionId) fail('scout needs --session <id>, a session id, or --pending');

    if (opt.background) {
      detach(['scout', '--session', sessionId, ...(opt.transcript ? ['--transcript', opt.transcript] : []), ...(opt.cwd ? ['--cwd', opt.cwd] : []),
        ...(opt.live ? ['--live'] : []), ...(opt.force ? ['--force'] : []), ...(opt.auto ? ['--auto'] : []), '--quiet']);
      return opt.json ? out(JSON.stringify({ status: 'background' })) : out('Scouting in the background. Run /casebook:list in a minute.');
    }

    let r;
    try {
      r = scoutSession({ sessionId, transcriptPath: opt.transcript, cwd: opt.cwd, force: Boolean(opt.force), live: Boolean(opt.live), mode: opt.auto ? 'auto' : 'manual' }, config);
    } catch (err) {
      U.logError(`scout failed for ${sessionId}`, err);
      if (opt.quiet) return;
      fail(`scout failed: ${err.message}`);
    }
    if (opt.quiet) {
      if (r.status === 'running' || (r.status === 'skipped' && r.reason === 'transcript not found')) U.logError(`scout for ${sessionId} not run: ${r.reason}`);
      return;
    }
    out(opt.json ? JSON.stringify(r) : describe(r));
  },

  async discover({ pos, opt }) {
    const config = U.loadConfig();
    if (pos[0] === 'pick') {
      if (!/^d-[a-z0-9]{6}$/.test(pos[1] || '') || !pos[2]) fail('usage: discover pick <discovery-id> <topic number>');
      const r = D.pick(config, pos[1], pos[2]);
      if (opt.json) return out(JSON.stringify(r));
      if (r.status === 'exists') return out(`Already logged as ${r.logId}: ${r.title}`);
      const n = r.sessions.length;
      out(`${r.status === 'created' ? 'Created' : 'Updated'} ${r.logId} (score ${r.score}${r.partial ? ', partial' : ''}, ${n} session${n > 1 ? 's' : ''}): ${r.title}`);
      if (r.merged.length) out(`Merged into it: ${r.merged.join(', ')} (duplicates of this topic; marks and written files carried over)`);
      return;
    }
    const minScore = opt.minScore === undefined ? null : Number(opt.minScore);
    if (minScore !== null && !(Number.isInteger(minScore) && minScore >= 1 && minScore <= 5)) fail(`--min-score must be a whole number from 1 to 5, got "${opt.minScore}"`);
    const candidates = Math.min(8, parseLimit(opt.candidates, 5, '--candidates'));
    const project = currentProject(opt, config);
    const r = await D.discover(config, {
      note: opt.note || pos.join(' ') || '',
      tags: String(opt.tags || '').split(',').filter((t) => t.trim()),
      minScore, since: opt.since, project, candidates, force: Boolean(opt.force), dryRun: Boolean(opt.dryRun),
      exclude: opt.exclude ? [opt.exclude] : [],
    });
    const scope = project ? `"${project}"` : 'all projects';
    if (opt.dryRun) {
      if (opt.json) return out(JSON.stringify(r.shortlist.map((g) => ({ sessions: g.members.map((m) => m.sessionId), reasons: g.reasons, logs: [...new Set(g.members.flatMap((m) => m.logs.map((l) => l.id)))], prelim: Number(g.prelim.toFixed(2)) })), null, 2));
      out(`${r.sessions} session(s) in ${scope}, ${r.chains} linked chain(s), ${r.eligible} eligible. Would score ${r.shortlist.length} (one model call each):`);
      r.shortlist.forEach((g, i) => {
        out(`${i + 1}. ${g.members.map((m) => `${m.sessionId.slice(0, 8)} ${String(m.startedAt || '').slice(0, 10)}`).join(' → ')}`);
        if (g.reasons.length) out(`   linked: ${g.reasons.join('; ')}`);
        const logs = [...new Set(g.members.flatMap((m) => m.logs.map((l) => `${l.id} (${l.score})`)))];
        if (logs.length) out(`   logs: ${logs.join(', ')}`);
      });
      return;
    }
    if (opt.json) return out(JSON.stringify(r, null, 2));
    if (!r.topics.length) {
      if (!r.eligible) return out(`Nothing to discover in ${scope}: ${r.sessions} session(s), none${opt.tags ? ' that mention those tags' : ' long enough'}.`);
      out(`No topic matched. Scored ${r.scored} candidate(s) in ${scope}; the best scored ${r.best || '-'}.`);
      if (r.failed.length) out(`${r.failed.length} scout(s) failed: ${r.failed[0]}`);
      return;
    }
    out(`Discovery ${r.id} · ${r.topics.length} topic(s) from ${r.scored} candidate(s) · ${r.sessions} session(s) in ${scope}`);
    for (const t of r.topics) {
      const ms = t.members;
      const last = ms.map((m) => m.endedAt || '').sort().pop();
      const span = `${String(ms[0].startedAt || '').slice(0, 10)} → ${String(last || '').slice(0, 10)}`;
      out('');
      out(`${t.rank}. [${t.score}${t.partial ? '…' : ''}] ${t.topic.title}`);
      out(`   ${t.info.project} · ${t.topic.angle || 'general'} · ${ms.length} session${ms.length > 1 ? 's' : ''} · ${span}${t.fit ? ` · fit ${t.fit}/3` : ''}`);
      if (t.topic.summary) out(`   ${t.topic.summary}`);
      if (t.topic.tags.length) out(`   tags: ${t.topic.tags.join(', ')}`);
      if (t.reasons.length) out(`   linked: ${t.reasons.join('; ')}`);
      out(`   sessions: ${ms.map((m) => `${m.sessionId.slice(0, 8)} (${String(m.startedAt || '').slice(0, 10)}, ${m.userTurns} turns)`).join(', ')}`);
      out(t.updates.length > 1 ? `   merges: ${t.updates.join(', ')} (duplicates of this topic)` : t.updates.length ? `   updates: ${t.updates[0]}` : '   new log');
    }
    if (r.failed.length) { out(''); out(`${r.failed.length} scout(s) failed: ${r.failed[0]}`); }
  },

  maintenance({ opt }) {
    const config = U.loadConfig();
    if (config.sweep.enabled) {
      const meta = U.readJson(U.paths.meta(), {});
      sweep(config, {
        since: meta.installedAt ? new Date(meta.installedAt) : null,
        exclude: opt.exclude,
        limit: config.sweep.maxPerRun,
        settleMinutes: config.sweep.settleMinutes,
      });
    }
  },

  profiles({ opt }) {
    const list = U.listProfiles();
    if (opt.json) return out(JSON.stringify(list, null, 2));
    if (!list.length) return out('No casebook stores yet.');
    const w = Math.max(7, ...list.map((p) => p.name.length));
    const wd = Math.max(10, ...list.map((p) => String(p.claudeConfigDir || '-').length));
    out(`  ${pad('PROFILE', w)}  ${pad('CONFIG DIR', wd)}  LOGS  LAST LOG`);
    for (const p of list) out(`${p.current ? '*' : ' '} ${pad(p.name, w)}  ${pad(p.claudeConfigDir || '-', wd)}  ${String(p.logs).padStart(4)}  ${p.lastLog || '-'}`);
  },

  list({ opt }) {
    const config = U.loadConfig();
    const project = currentProject(opt, config);
    const since = opt.since ? U.parseAge(opt.since) : null;
    let logs = store.allLogs(project);
    if (opt.marked) logs = logs.filter((l) => l.meta.marked);
    if (opt.minScore) logs = logs.filter((l) => (l.meta.score || 0) >= Number(opt.minScore));
    if (opt.unwritten) logs = logs.filter((l) => !F.isWritten(l));
    if (opt.written) logs = logs.filter((l) => F.isWritten(l));
    if (since) logs = logs.filter((l) => new Date(l.meta.started_at || l.meta.created_at) >= since);

    if (opt.json) return out(JSON.stringify(logs.map((l) => ({ ...l.meta, file: l.file })), null, 2));
    out(`[profile: ${U.paths.profileName()}]`);
    if (!logs.length) {
      const others = store.listProjects().filter((p) => p !== project);
      out(project ? `No casebook logs for "${project}" match.` : 'No casebook logs match.');
      if (project && others.length) out(`Other projects: ${others.join(', ')} (use --project <name> or --all)`);
      return;
    }
    const groups = new Map();
    for (const l of logs) {
      const k = l.meta.project || '?';
      if (!groups.has(k)) groups.set(k, []);
      groups.get(k).push(l);
    }
    for (const [name, items] of groups) {
      const repo = items[0].meta.repo;
      const marked = items.filter((l) => l.meta.marked).length;
      out(`${name}${repo ? `  (${repo})` : ''}  ·  ${items.length} log${items.length > 1 ? 's' : ''}, ${marked} marked`);
      out(HEADER);
      for (const l of items) out(row(l));
      out();
    }
  },

  show({ pos, opt }) {
    const log = findLog(pos[0] || '');
    if (!log) fail(`no log with id "${pos[0] || ''}"`);
    out(opt.path ? log.file : fs.readFileSync(log.file, 'utf8'));
  },

  mark({ pos, opt }) {
    U.loadConfig();
    if (pos[0] && U.ID_RE.test(pos[0])) {
      // Logs are shared between sessions: read and save under the write lock so a scan cannot undo the change.
      const log = store.withWriteLock(() => {
        const l = findLog(pos[0]);
        return l && store.applyMark(l, pos.slice(1).join(' '));
      });
      if (!log) fail(`no log with id "${pos[0]}"`);
      return out(`📌 Marked ${log.meta.id}: ${log.meta.title}`);
    }
    if (!opt.session) fail('mark needs a log ID, or --session <id> to mark the current session');
    const note = pos.join(' ');
    // A session with exactly one log: mark that log. With several, the next scan gives the mark to the topic it points to.
    const one = store.withWriteLock(() => {
      // Recorded so the scan knows a bare /casebook:mark in the transcript (its note written by the skill) was placed.
      store.setLedger(opt.session, { sessionMarked: true });
      const logs = T.logsForSessions([opt.session]);
      return logs.length === 1 ? store.applyMark(logs[0], note) : null;
    });
    if (one) return out(`📌 Marked ${one.meta.id} (this session's existing log)${note ? `: ${note}` : ''}`);
    const marks = store.withWriteLock(() => { store.setLedger(opt.session, { sessionMarked: true }); return store.addPendingMark(opt.session, note); });
    out(`📌 Marked this session${note ? `: ${note}` : ''} (${marks.length} mark${marks.length > 1 ? 's' : ''}). It goes to the topic it points to when the session is scanned.`);
  },

  unmark({ pos }) {
    U.loadConfig();
    const log = store.withWriteLock(() => { const l = findLog(pos[0] || ''); return l && store.clearLogMarks(l); });
    if (!log) fail(`no log with id "${pos[0] || ''}"`);
    out(`Unmarked ${log.meta.id}`);
  },

  written({ pos, opt }) {
    if (!opt.file) fail('written needs --file <path>');
    for (const id of pos) {
      const log = store.withWriteLock(() => {
        const l = findLog(id);
        if (!l) return null;
        const list = new Set(l.meta.written_to || []);
        list.add(path.resolve(U.expandHome(opt.file)));
        l.meta.written_to = [...list];
        l.meta.written_at = new Date().toISOString();
        return store.saveLog(l);
      });
      if (!log) fail(`no log with id "${id}"`);
    }
    out(`Recorded ${pos.length} log(s) as written to ${opt.file}`);
  },

  'out-path'({ opt }) {
    const config = U.loadConfig();
    if (!opt.project) fail('out-path needs --project <name>');
    // --handoff names a new folder (not a file) under handoffs/, for /casebook:handoff.
    const root = opt.handoff
      ? opt.dir || path.join(U.paths.home(), 'handoffs')
      : opt.dir || config.output.dir || path.join(U.paths.home(), 'case-studies');
    const dir = U.mkdirp(path.join(U.expandHome(root), U.slugify(opt.project)));
    // Local date, so a file written late in the evening is not named after tomorrow (UTC).
    const now = new Date();
    const day = [now.getFullYear(), now.getMonth() + 1, now.getDate()].map((n) => String(n).padStart(2, '0')).join('-');
    const base = `${day}-${U.slugify(opt.title)}`;
    const ext = opt.handoff ? '' : '.md';
    let file = path.join(dir, `${base}${ext}`);
    for (let n = 2; fs.existsSync(file); n++) file = path.join(dir, `${base}-${n}${ext}`);
    out(file);
  },

  delete({ pos, opt }) {
    U.loadConfig();
    let logs;
    if (pos.length) {
      // Exact IDs only: deleting a merged ID must not delete the log it was merged into.
      logs = pos.map((id) => store.findLog(id) || fail((() => {
        const into = U.ID_RE.test(id) && T.resolveLog(id);
        return into ? `${id} was merged into ${into.meta.id}; delete ${into.meta.id} if you mean that log` : `no log with id "${id}"`;
      })()));
    } else {
      try { logs = F.filterLogs(opt); } catch (err) { fail(err.message); }
    }
    if (!logs.length) return out('Nothing matches.');
    const batch = !pos.length;
    if (batch && !opt.yes) {
      out(`Would delete ${logs.length} log(s). Re-run with --yes to delete:`);
      out(HEADER);
      for (const l of logs) out(row(l));
      return;
    }
    // A log merged into another one (or deleted) since it was listed is reported, not counted.
    const done = logs.filter((l) => store.deleteLog(l)).map((l) => l.meta.id);
    const missed = logs.map((l) => l.meta.id).filter((id) => !done.includes(id));
    if (done.length) out(`Deleted ${done.length} log(s): ${done.join(', ')}`);
    for (const id of missed) {
      const into = T.resolveLog(id);
      out(into ? `Not deleted: ${id} was merged into ${into.meta.id} since it was listed` : `Not deleted: ${id} is already gone`);
    }
  },

  backfill({ opt }) {
    const config = U.loadConfig();
    const since = U.parseAge(opt.since || '30d');
    const limit = parseLimit(opt.limit, 20);
    if (!opt.yes) {
      out(`Backfill would scout up to ${limit} past session(s) since ${since.toISOString().slice(0, 10)}, one headless ${config.scout.model} call each.`);
      out('Re-run with --yes to start.');
      return;
    }
    const { locked } = sweep(config, {
      since, limit, settleMinutes: 0, partialIfRecent: true,
      onResult: (c, r) => out(`${c.sessionId.slice(0, 8)}  ${r.status}${r.logs && r.logs.length ? ' ' + r.logs.map((l) => l.logId).join(', ') : r.logId ? ' ' + r.logId : ''}${r.reason ? ' (' + r.reason + ')' : ''}${r.title ? ' — ' + r.title : ''}`),
    });
    if (locked) out('A catch-up is already running. Check /casebook:list in a minute.');
  },

  config() {
    U.loadConfig();
    out(U.paths.config());
    out(fs.readFileSync(U.paths.config(), 'utf8'));
  },

  doctor() {
    const config = U.loadConfig();
    // Probe the way the real scout runs: CLAUDE_CONFIG_DIR is set only when it matters (see paths.claudeConfigDirExplicit).
    const probeEnv = { ...process.env };
    if (U.paths.claudeConfigDirExplicit()) probeEnv.CLAUDE_CONFIG_DIR = U.paths.claudeConfigDir();
    const which = spawnSync(config.scout.command, ['--version'], { encoding: 'utf8', env: probeEnv });
    const project = resolveProject(process.cwd(), config);
    const meta = U.readJson(U.paths.meta(), {});
    out(`node        ${process.version}`);
    out(`profile     ${U.paths.profileName()}`);
    out(`config dir  ${U.paths.claudeConfigDir()}`);
    out(`store       ${U.paths.home()}`);
    out(`scout       ${config.scout.command} → ${which.status === 0 ? which.stdout.trim() : 'NOT FOUND'} (model ${config.scout.model}, CLAUDE_CONFIG_DIR ${U.paths.claudeConfigDirExplicit() ? 'set' : 'left unset'})`);
    out(`this dir    project "${project.project}", policy ${project.policy}${project.repo ? `, ${project.repo}` : ''}`);
    out(`logs        ${store.allLogs().length} across ${store.listProjects().length} project(s)`);
    out(`installed   ${meta.installedAt || '-'}`);
    try {
      const lines = fs.readFileSync(U.paths.errorLog(), 'utf8').trim().split('\n').slice(-5);
      out(`recent errors (${U.paths.errorLog()}):`);
      for (const l of lines) out(`  ${l.slice(0, 300)}`);
    } catch { out('recent errors  none'); }
  },

  help() {
    out(`casebook — capture potential case studies from Claude Code sessions

  list [--project P | --all] [--marked] [--min-score N] [--unwritten|--written] [--since 30d] [--json]
  show <id> [--path]
  mark [<id>] [note…] [--session <session-id>]     mark a log, or the current session
  unmark <id>
  delete <id…>                                     delete specific logs
  delete [--project P] [--below-score N] [--older-than 30d] [--unmarked] [--written|--unwritten] [--yes]
  scout [<session-id>] [--live] [--background] [--force]   scout one session now (default: manual)
  scout --pending [--dry-run] [--limit N] [--exclude <session-id>]   catch up on missed sessions now
  discover [--note "…"] [--min-score N] [--tags a,b] [--project P | --all] [--since 90d] [--candidates 5] [--dry-run]
                                                   find topics across linked sessions, ranked (top 3)
  discover pick <discovery-id> <n>                 log topic n of a discovery as one log
  profiles [--json]                                list every profile's store
  backfill [--since 30d] [--limit 20] [--yes]      scout past sessions
  written <id…> --file <path>                      record that logs were written up
  out-path --project P --title T [--dir D] [--handoff]   where a case study file (or handoff folder) should go
  config | doctor | help\n\nGlobal: --profile <name> runs against another profile's store (see: casebook profiles).`);
  },
};

const { pos, opt } = parseArgs(process.argv.slice(2));
const name = pos.shift() || 'help';
const fn = commands[name];
if ('profile' in opt && fn && !opt.help && name !== 'help') {
  try { U.useProfile(opt.profile); } catch (err) { fail(err.message); }
}
if (!fn || opt.help) commands.help();
else {
  const onError = (err) => {
    if (!err.user) U.logError(`command ${name} failed`, err);
    fail(err.message);
  };
  try {
    const r = fn({ pos, opt });
    if (r && typeof r.then === 'function') r.catch(onError);
  } catch (err) {
    onError(err);
  }
}
